#!/usr/bin/env python3
"""Count the leak-indicator classes in a Mouser heap.

Runs ``heap -s <pid>`` (Xcode command-line tools) and prints one JSON
object::

    {"pid": 3191, "ts": 1758493271,
     "classes": {"CGEvent": 3217274, "CGSEventAppendix": 3217274,
                 "HIDEvent": 9357423, "NSXPCConnection": 729457,
                 "GPProcessMonitor": 729442, "CGImage": 158,
                 "non-object": 17142676},
     "total_bytes": 5874279184}

The classes are the fingerprints of the 2026-09 leaks (see
``docs/memory-guards.md``): CGEvent/CGSEventAppendix/HIDEvent grow with
the PyObjC tap trampoline leak, NSXPCConnection/GPProcessMonitor with the
LaunchServices foreground query leak, CGImage with QML image churn.
``deskflow/tools/fleet-soak --heap-classes`` samples this per tick and
reports a per-class slope.

``--parse FILE`` reads a saved ``heap -s`` report instead of a process.

Exit status: 0 on success, 1 on usage errors, 2 when ``heap`` is missing,
cannot attach (needs ``get-task-allow`` or sudo), the process is gone, or
the output does not have the COUNT/BYTES/AVG/CLASS_NAME table this
parser expects. The JSON keys (``pid``, ``ts``, ``classes``,
``total_bytes``) are consumed by ``fleet-soak``; keep them stable.
Stdlib only.
"""

from __future__ import annotations

import argparse
import json
import re
import shutil
import subprocess
import sys
import time

CLASSES = (
    "CGEvent",
    "CGSEventAppendix",
    "HIDEvent",
    "NSXPCConnection",
    "GPProcessMonitor",
    "CGImage",
    "non-object",
)

_ROW = re.compile(r"^\s*(\d+)\s+(\d+)\s+([\d.]+)\s+(\S.*?)\s*$")
_TOTAL = re.compile(r"^All zones:\s+(\d+)\s+nodes\s+\((\d+)\s+bytes\)")
_TYPES = {"ObjC", "CFType", "C++", "C", "Swift"}


class HeapFormatError(ValueError):
    """The text is not a ``heap -s`` report (no COUNT/BYTES/CLASS_NAME table)."""


_HEADER_COLUMNS = ("COUNT", "BYTES", "AVG", "CLASS_NAME")


def parse_heap_s(text: str) -> dict:
    """Parse ``heap -s`` output into ``{"classes": {...}, "total_bytes": int,
    "nodes": int}``. Classes absent from the report count as 0. Raises
    HeapFormatError when the per-class table header is missing or its
    columns are not the ones this parser was written against."""
    classes = dict.fromkeys(CLASSES, 0)
    total_bytes = 0
    nodes = 0
    in_table = False
    for line in text.splitlines():
        total = _TOTAL.match(line)
        if total:
            nodes = int(total.group(1))
            total_bytes = int(total.group(2))
            continue
        stripped = line.strip()
        if not in_table and stripped.startswith("COUNT"):
            if tuple(stripped.split()[:4]) != _HEADER_COLUMNS:
                raise HeapFormatError(
                    f"unexpected heap -s columns: {stripped!r} "
                    f"(want {' '.join(_HEADER_COLUMNS)} ...)"
                )
            in_table = True
            continue
        if not in_table or not stripped or stripped.startswith("====="):
            continue
        row = _ROW.match(line)
        if not row:
            continue
        count = int(row.group(1))
        # CLASS_NAME may contain single spaces ("NSMutableArray (Storage)",
        # "dispatch_queue_t (serial)"); columns are separated by 2+ spaces.
        # "non-object" has no TYPE/BINARY columns at all.
        columns = re.split(r"\s{2,}", row.group(4))
        name = columns[0]
        if len(columns) > 1 and columns[1] not in _TYPES:
            continue
        if name in classes:
            classes[name] += count
    if not in_table:
        raise HeapFormatError("no per-class table (COUNT BYTES AVG CLASS_NAME) found")
    return {"classes": classes, "total_bytes": total_bytes, "nodes": nodes}


def _pid_for_name(name: str) -> int | None:
    pgrep = shutil.which("pgrep")
    if pgrep is None:
        return None
    result = subprocess.run([pgrep, "-x", name], capture_output=True, text=True)
    pids = [int(p) for p in result.stdout.split() if p.isdigit()]
    if not pids:
        return None
    if len(pids) > 1:
        print(f"mouser-heap-classes: {len(pids)} processes named {name}; using {pids[0]}",
              file=sys.stderr)
    return pids[0]


def run_heap(pid: int) -> str:
    """Return ``heap -s`` output for ``pid``; raises RuntimeError with a
    user-facing message when heap is unavailable or cannot attach."""
    heap = shutil.which("heap")
    if heap is None:
        raise RuntimeError(
            "heap not found; install the Xcode command-line tools "
            "(xcode-select --install)"
        )
    try:
        result = subprocess.run([heap, "-s", str(pid)], capture_output=True, text=True)
    except OSError as exc:
        raise RuntimeError(f"could not run heap: {exc}") from exc
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip().splitlines()
        message = detail[-1] if detail else f"heap exited {result.returncode}"
        raise RuntimeError(
            f"heap -s {pid} failed: {message} "
            "(a hardened Mouser needs the get-task-allow entitlement, or run with sudo)"
        )
    return result.stdout


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    target = parser.add_mutually_exclusive_group(required=True)
    target.add_argument("--pid", type=int, help="process to sample")
    target.add_argument("--name", help="process name to sample (pgrep -x)")
    target.add_argument("--parse", metavar="FILE", help="parse a saved heap -s report")
    args = parser.parse_args(argv)

    pid = args.pid
    if args.parse:
        try:
            with open(args.parse, encoding="utf-8", errors="replace") as fh:
                text = fh.read()
        except OSError as exc:
            print(f"mouser-heap-classes: {exc}", file=sys.stderr)
            return 1
        match = re.search(r"^Process:\s+.*\[(\d+)\]", text, re.MULTILINE)
        pid = int(match.group(1)) if match else None
    else:
        if args.name:
            pid = _pid_for_name(args.name)
            if pid is None:
                print(f"mouser-heap-classes: no process named {args.name}", file=sys.stderr)
                return 2
        try:
            text = run_heap(pid)
        except RuntimeError as exc:
            print(f"mouser-heap-classes: {exc}", file=sys.stderr)
            return 2

    try:
        parsed = parse_heap_s(text)
    except HeapFormatError as exc:
        print(f"mouser-heap-classes: {exc}", file=sys.stderr)
        return 2
    report = {
        "pid": pid,
        "ts": int(time.time()),
        "classes": parsed["classes"],
        "total_bytes": parsed["total_bytes"],
    }
    json.dump(report, sys.stdout, separators=(",", ":"))
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
