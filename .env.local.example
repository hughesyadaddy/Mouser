# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and must NEVER be committed -- it carries
# machine-specific signing identities and install paths.
#
# scripts/build_and_install.py loads .env.local automatically (values
# already present in the environment take precedence).

# -- macOS code signing (required) -------------------------------------
# The SHA-1 of the codesigning identity to sign with: 40 hex digits, as
# printed by `security find-identity -v -p codesigning`.
#
# There is no ad-hoc fallback. An unset/empty value or `-` makes
# build_macos_app.sh and scripts/build_and_install.py exit 2 before
# building anything: an ad-hoc signature changes on every build, so macOS
# treats each deploy as a new app and resets its Accessibility / Input
# Monitoring grants.
#
# Preview what the build would do with:
#   .venv/bin/python scripts/build_and_install.py --dry-run
MOUSER_SIGN_IDENTITY=

# DEPRECATED alias: an Apple Developer Team ID (10 characters). Only used
# when MOUSER_SIGN_IDENTITY is empty; the build resolves it to the first
# matching keychain identity and warns. Pin the hash above instead.
#MOUSER_TEAM_ID=

# -- Windows code signing --------------------------------------------
# Signing is done by deskflow's scripts/sign-windows.ps1 (found via
# DESKFLOW_ROOT, default ~/Desktop/deskflow). It reads the thumbprint of
# the fleet certificate from DESKFLOW_SIGN_THUMBPRINT; an unset thumbprint
# or a missing signtool.exe fails the build.
#DESKFLOW_SIGN_THUMBPRINT=

# -- Optional overrides ------------------------------------------------
# Checkout of the deskflow repo that hosts the shared fleet tooling
# (tools/fleet-gui-exec.py, scripts/sign-windows.ps1).
#DESKFLOW_ROOT=~/Desktop/deskflow

# Install destination (default: /Applications on macOS, per-user app
# directory on Windows).
#MOUSER_INSTALL_DIR=

# Python interpreter used for the build (default: .venv, then PATH).
#MOUSER_PYTHON=
