# Virtual environment
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# IDE
.idea/
.cursor/
*.swp
*.swo

# Per-machine / per-user dev-environment pins. These commonly carry
# signing identities, API keys, install dirs, or runtime versions that
# are local to a single developer's setup.
.python-version
.tool-versions
.envrc
.env
.env.*
!.env.local.example
*.local.json

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Build artifacts
build_icon.py

# Local diagnostics (machine-specific install paths)
tools/probe_frozen_qml.py

# Shortcuts (user-specific paths)
*.lnk

# Native hook filter build output (native/win/build.py). Built per machine
# from mouser_hook.c; never committed, and optional at runtime.
native/win/*.dll
native/win/*.obj
native/win/*.lib
native/win/*.exp
